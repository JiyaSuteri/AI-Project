# AI-Based Restaurant Table Allocation and Service Planner
# Environment Configuration

PROJECT_NAME="AI-Based Restaurant Table Allocation and Service Planner"
VERSION="1.0.0"
API_V1_STR="/api"

# Server
HOST="127.0.0.1"
PORT=8000
DEBUG=True

# Database
DATABASE_URL="sqlite:///./restaurant_planner.db"

# Groq API
GROQ_API_KEY=""
